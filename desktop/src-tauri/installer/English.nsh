LangString MUI_TEXT_WELCOME_INFO_TITLE ${LANG_ENGLISH} "Welcome to Toph"
LangString MUI_TEXT_WELCOME_INFO_TEXT ${LANG_ENGLISH} "This wizard installs Toph on this computer. Afterwards you choose between connecting to a Toph server or opening a local workspace.$\r$\n$\r$\nClick Next to continue."
LangString MUI_TEXT_FINISH_INFO_TITLE ${LANG_ENGLISH} "Toph installed"
LangString MUI_TEXT_FINISH_INFO_TEXT ${LANG_ENGLISH} "Toph is ready. Open it from the shortcut and connect your server or use a local workspace."
