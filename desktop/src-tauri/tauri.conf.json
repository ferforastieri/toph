{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Toph",
  "version": "0.1.0",
  "identifier": "br.com.ferforastieri.toph",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build && npm --prefix .. run build:web",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Toph · Seu workbench",
        "width": 1120,
        "height": 760,
        "minWidth": 900,
        "minHeight": 620,
        "resizable": true,
        "center": true,
        "dragDropEnabled": false,
        "theme": "Dark",
        "backgroundColor": "#000000"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "Seu workbench local e self-hosted",
    "longDescription": "Toph é seu workbench para servidores self-hosted e workspaces locais, com identidade própria em cada projeto.",
    "publisher": "Toph",
    "copyright": "Copyright © 2026 Toph",
    "homepage": "https://github.com/ferforastieri/toph",
    "category": "DeveloperTool",
    "license": "MIT",
    "licenseFile": "../../LICENSE",
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico",
        "headerImage": "installer/nsis-header.bmp",
        "uninstallerHeaderImage": "installer/nsis-uninstaller-header.bmp",
        "sidebarImage": "installer/nsis-sidebar.bmp",
        "installMode": "both",
        "startMenuFolder": "Toph",
        "languages": [
          "PortugueseBR",
          "English",
          "Spanish"
        ],
        "customLanguageFiles": {
          "PortugueseBR": "installer/PortugueseBR.nsh",
          "Spanish": "installer/Spanish.nsh",
          "English": "installer/English.nsh"
        },
        "displayLanguageSelector": true,
        "compression": "lzma"
      },
      "wix": {
        "language": [
          "pt-BR",
          "en-US",
          "es-ES"
        ],
        "bannerPath": "installer/wix-banner.bmp",
        "dialogImagePath": "installer/wix-dialog.bmp"
      }
    }
  }
}
