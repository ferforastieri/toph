{
  "name": "toph-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "monaco": "node scripts/copy-monaco.mjs",
    "predev:app": "npm run sync-brand && npm run monaco",
    "dev:app": "vite --config vite.app.config.ts --host 0.0.0.0",
    "dev:landing": "vite --config vite.landing.config.ts --host 0.0.0.0",
    "dev": "npm run dev:app",
    "build": "npm run build:app",
    "prebuild:app": "npm run sync-brand && npm run monaco",
    "build:app": "vite build --config vite.app.config.ts",
    "build:landing": "vite build --config vite.landing.config.ts",
    "preview:app": "vite preview --config vite.app.config.ts --host 0.0.0.0",
    "preview:landing": "vite preview --config vite.landing.config.ts --host 0.0.0.0",
    "test": "vitest run --config vitest.config.ts",
    "sync-brand": "node scripts/sync-brand.mjs",
    "predev:landing": "npm run sync-brand",
    "prebuild:landing": "npm run sync-brand"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.2.8",
    "@fontsource/ibm-plex-mono": "^5.2.7",
    "@monaco-editor/react": "^4.7.0",
    "@opencode/client": "^2.1.3",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "lucide-react": "^1.61.0",
    "monaco-editor": "^0.57.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^30.1.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
