{
  "name": "toph",
  "private": true,
  "version": "0.8.10",
  "workspaces": [
    "apps/web",
    "apps/landing",
    "apps/client",
    "packages/brand",
    "packages/ui",
    "packages/icons"
  ],
  "scripts": {
    "dev:web": "npm run dev --workspace @toph/web",
    "dev:landing": "npm run dev --workspace @toph/landing",
    "build:web": "npm run build --workspace @toph/web",
    "build:landing": "npm run build --workspace @toph/landing",
    "build:client": "npm run build --workspace @toph/client",
    "test": "npm run test --workspace @toph/web",
    "sync-brand": "npm run sync --workspace @toph/brand",
    "build:server": "cargo build --release --manifest-path services/toph/Cargo.toml --bin toph",
    "test:server": "cargo test --manifest-path services/toph/Cargo.toml"
  },
  "overrides": {
    "dompurify": "3.4.17"
  },
  "dependencies": {}
}
