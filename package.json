{
  "name": "toph",
  "private": true,
  "version": "0.8.8",
  "workspaces": [
    "apps/web",
    "apps/landing",
    "apps/desktop",
    "packages/brand",
    "packages/ui"
  ],
  "scripts": {
    "dev:web": "npm run dev --workspace @toph/web",
    "dev:landing": "npm run dev --workspace @toph/landing",
