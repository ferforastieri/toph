{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "remote-update",
  "description": "Allows self-hosted web UIs to request a verified desktop installer download.",
  "windows": [
    "main"
  ],
  "remote": {
    "urls": [
      "https://*:*",
      "http://*:*",
      "https://*",
      "http://*"
    ]
  },
  "permissions": [
    "core:default",
    "allow-download-update"
  ]
}
