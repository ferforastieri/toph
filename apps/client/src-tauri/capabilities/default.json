{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default permissions for the Toph launcher window",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "dialog:default",
    "allow-validate-server",
    "allow-open-server",
    "allow-start-local-server",
    "allow-is-mobile",
    "allow-environment-status",
    "allow-install-environment",
    "allow-restart-app"
  ]
}
